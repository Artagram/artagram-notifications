SERVER_PORT=8090

SPRING_DATA_MONGODB_URI=mongodb://artagram:artagram@localhost:27017/db_notificaciones?authSource=admin

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Vhost dedicado para aislar el trafico de notificaciones del resto de
# servicios (que siguen usando el vhost "/"). Ver artagram-infra para el
# shovel que puentea artagram.events desde "/" hacia este vhost.
RABBITMQ_VHOST=notifications
RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=notifications_secret
RABBITMQ_EXCHANGE=artagram.events

JWT_PUBLIC_KEY_PATH=../artagram-infra/secrets-dev/jwt-public.pem
JWT_PUBLIC_KEY_PEM=

CORS_ORIGINS=http://localhost:5173

EMAIL_MODE=log
EMAIL_FROM=no-reply@artagram.local

SPRING_PROFILES_ACTIVE=
